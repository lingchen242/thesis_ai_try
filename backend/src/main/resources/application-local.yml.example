# =============================================================================
# 本地配置示例
#
# 用法：
#   1. 复制本文件为同目录下的 application-local.yml
#   2. 把下面的 __MYSQL_*__ 占位符替换为你的 MySQL 连接信息
#   3. 直接启动即可 —— application.yml 中已设置默认激活 local profile，无需额外参数
#
# 为什么单独放一个文件：
#   application.yml 是版本控制中的模板，只含占位符；
#   个人连接信息放这里，而 .gitignore 已忽略 application-local.yml，不会被提交。
# =============================================================================

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/thesis_mgmt?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: __MYSQL_USERNAME__
    password: __MYSQL_PASSWORD__

thesis:
  jwt:
    # JWT 签名密钥（HS256，至少 32 字节）。
    # 留空或删除本行时，服务启动会随机生成一个 —— 好处是仓库里不存在固定密钥，
    # 代价是每次重启都会让已签发的 Token 立即失效。
    # 需要固定值请自行生成，例如：openssl rand -base64 48
    secret: "__请填入自行生成的随机字符串（>= 32 字节）__"
