# =============================================================================
# EditorConfig —— 跨编辑器统一基础格式
# 与 frontend/.prettierrc.json、后端 Java 约定保持一致
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# 后端 Java 使用 4 空格缩进
[*.java]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
